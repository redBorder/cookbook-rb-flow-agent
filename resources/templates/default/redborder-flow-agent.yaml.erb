<%# Full config, every key even when it is the default, so the names are easy to find. Strings as JSON = valid YAML. %>
<% s = @settings %>
sensor_name: <%= @sensor_name.to_s.to_json %>
sensor_ip: <%= @sensor_ip.to_s.to_json %>
tag: ""
tag2: ""
enrichments:
<% @enrichment.each do |key, value| %>
  <%= key %>: <%= value.to_s.to_json %>
<% end %>

home_nets:
<% @home_nets.each do |net| %>
  - <%= net.to_json %>
<% end %>

sensors:
<% @split_sensors.each do |sensor| %>
  - name: <%= sensor['name'].to_s.to_json %>
    sensor_ip: <%= sensor['sensor_ip'].to_json %>
    subnets:
<% sensor['subnets'].each do |subnet| %>
      - <%= subnet.to_json %>
<% end %>
    tag: ""
    tag2: ""
    enrichments:
<% sensor['enrichments'].each do |key, value| %>
      <%= key %>: <%= value.to_s.to_json %>
<% end %>
<% end %>

system:
  cores: <%= @cores %>
  cpu_affinity: <%= @cpu_affinity.to_json %>

stats:
  enabled: true
  socket_path: <%= @stats_socket_path.to_json %>
  http_addr: <%= s['stats_http_addr'].to_json %>

capture:
  interfaces:
    - <%= @iface.to_json %>
  promiscuous: <%= s['promiscuous'] %>
  snaplen: <%= s['snaplen'] %>
  workers_per_interface: <%= s['workers_per_interface'] %>
  buffer_size_mb: <%= s['buffer_size_mb'] %>

analysis:
  track_open_ports: <%= s['track_open_ports'] %>
  track_tcp_metrics: <%= s['track_tcp_metrics'] %>
  extract_tls_sni: <%= s['extract_tls_sni'] %>
  extract_tls_version: <%= s['extract_tls_version'] %>
  extract_http_host: <%= s['extract_http_host'] %>
  extract_http_details: <%= s['extract_http_details'] %>
  extract_dns_domains: <%= s['extract_dns_domains'] %>
  dns_cache_size: <%= s['dns_cache_size'] %>
  ja4_signatures_file: <%= @ja4_signatures_file.to_json %>

flow:
  mode: <%= @flow_mode.to_json %>
  active_timeout_sec: <%= s['active_timeout_sec'] %>
  inactive_timeout_sec: <%= s['inactive_timeout_sec'] %>
  max_active_flows: <%= s['max_active_flows'] %>
  shards: <%= s['shards'] %>

exporter:
  type: <%= @exporter_type.to_json %>
  target: <%= @target_host.to_json %>
  port: <%= @target_port %>
  engine_id: <%= s['engine_id'] %>
  engine_type: <%= @engine_type %>
  source_id: <%= @source_id %>
  template_interval_sec: <%= s['template_interval_sec'] %>
  sflow_sampling_rate: <%= @sampling_rate %>

kafka:
  brokers: <%= @kafka_brokers.to_json %>
  topic: <%= @kafka_topic.to_json %>
  batch_size: <%= s['batch_size'] %>
  compression: <%= s['compression'].to_json %>
