sensor_name: "<%= @sensor_name %>"
sensor_ip: "<%= @sensor_ip %>"
tag: "traffic"
tag2: "<%= @observation_id %>"
<% if @enrichment.any? %>
enrichments:
<% @enrichment.each do |key, value| %>
  <%= key %>: "<%= value %>"
<% end %>
<% end %>
<% if @home_nets.any? %>
home_nets:
<% @home_nets.each do |net| %>
  - "<%= net %>"
<% end %>
<% end %>
<% if @cores || @cpu_affinity %>
system:
<% if @cores %>
  cores: <%= @cores %>
<% end %>
<% if @cpu_affinity %>
  cpu_affinity: "<%= @cpu_affinity %>"
<% end %>
<% end %>
capture:
  interfaces:
    - "<%= @iface %>"
  workers_per_interface: <%= @cores || 2 %>
flow:
  mode: "<%= @flow_mode %>"
  active_timeout_sec: 30
exporter:
  type: "<%= @exporter_type %>"
<% if @exporter_type == "kafka" %>
kafka:
  brokers:
<% @kafka_brokers.each do |broker| %>
    - "<%= broker %>"
<% end %>
  topic: "<%= @kafka_topic %>"
<% else %>
  target: "<%= @target_host %>"
  port: <%= @target_port %>
<% if @obs_num && @exporter_type == "netflow5" %>
  engine_type: <%= @obs_num %>
  engine_id: 0
<% elsif @obs_num && %w(netflow9 ipfix).include?(@exporter_type) %>
  source_id: <%= @obs_num %>
<% end %>
<% if @exporter_type == "sflow" && @sampling_rate %>
  sflow_sampling_rate: <%= @sampling_rate %>
<% end %>
<% end %>
<% if @observation_id_filters.any? && !@split_traffic_logstash %>
sensors:
<% @observation_id_filters.each_with_index do |filter, idx| %>
  - name: "<%= filter['name'] || "split_#{idx}" %>"
<% if filter['sensor_ip'] %>
    sensor_name: "<%= filter['name'] %>"
    sensor_ip: "<%= filter['sensor_ip'] %>"
<% end %>
    subnets:
      - "<%= filter['subnet'] %>"
    tag2: "<%= filter['observation_id'] %>"
<% if filter['enrichment'] && filter['enrichment'].any? %>
    enrichments:
<% filter['enrichment'].each do |key, value| %>
      <%= key %>: "<%= value %>"
<% end %>
<% end %>
<% end %>
<% end %>
stats:
  enabled: true
  socket_path: "/var/run/redborder-flow-agent-<%= @iface %>.sock"
